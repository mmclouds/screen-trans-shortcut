# 目标翻译语言，例如：zh-中文，en-英文，ja-日语，ko-韩语等
TARGET_LANGUAGE=zh

# API访问密码，用于验证客户端请求的合法性
API_PASSWORD=your_strong_password_here

# 火山引擎访问密钥
VOLC_ACCESS_KEY=AKLTNxxxxxxxxxxxxxxxxxxxxxxxx
VOLC_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare R2 (图片存储)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=screen-trans-images
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Cloudflare Worker API (D1 数据层)
WORKER_API_URL=https://screen-trans-api.xxx.workers.dev
WORKER_API_KEY=your_shared_secret

# OpenRouter AI (词汇语法提取)
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=openai/gpt-4o-mini
